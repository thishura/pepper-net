// ============================================================================
// Sri Lankan Multi-Outlet Takeaway — Restaurant Management System
// Phase 1: Complete Prisma Schema
// ----------------------------------------------------------------------------
// Design principles:
//   - Strict multi-tenancy: every transactional row carries an `outletId`.
//   - RBAC via a global `users` table + `user_outlet_assignments` join table.
//   - Fractional recipe costing: RecipeItem stores fractional quantities of
//     ingredients consumed per menu item.
//   - Per-outlet live stock keyed on the composite (ingredientId, outletId).
//   - Order pipeline state machine: Draft → Confirmed → In_Kitchen → Ready →
//     Completed (+ Cancelled).
//   - Inventory ledger: every PurchaseItem / WasteLogItem / order confirmation
//     produces a StockMovement row, so on-hand stock is always auditable.
// ============================================================================

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

// ============================================================================
// ENUMS
// ============================================================================

enum UserRole {
  SUPER_ADMIN
  OUTLET_MANAGER
  CASHIER
  CHEF
}

enum OrderStatus {
  DRAFT
  CONFIRMED
  IN_KITCHEN
  READY
  COMPLETED
  CANCELLED
}

enum OrderType {
  TAKEAWAY
  DINE_IN
  DELIVERY
}

enum PaymentMethod {
  CASH
  CARD
  ONLINE
  WALLET
}

enum PaymentStatus {
  PENDING
  PAID
  PARTIALLY_PAID
  REFUNDED
  FAILED
}

// Unit of measure for ingredients. Base units keep stock math consistent.
enum UnitOfMeasure {
  GRAM
  KILOGRAM
  MILLILITRE
  LITRE
  PIECE
}

// Direction/source of every inventory change, for a full audit trail.
enum StockMovementType {
  PURCHASE // stock in, from a supplier purchase
  SALE // stock out, from a confirmed order's recipe deduction
  WASTE // stock out, from the chef daily waste log
  ADJUSTMENT // manual correction (stock take, theft, etc.)
  TRANSFER_IN // inter-outlet transfer received
  TRANSFER_OUT // inter-outlet transfer sent
}

enum ExpenseCategory {
  RENT
  UTILITIES
  SALARIES
  MAINTENANCE
  MARKETING
  PACKAGING
  TRANSPORT
  MISCELLANEOUS
}

enum PrintJobType {
  KOT // Kitchen Order Ticket
  RECEIPT // Customer receipt
  REPORT
}

enum PrintJobStatus {
  QUEUED
  PRINTING
  PRINTED
  FAILED
}

// ============================================================================
// TENANCY & ORGANISATION
// ============================================================================

model Outlet {
  id        String   @id @default(cuid())
  name      String
  code      String   @unique // short code, e.g. "COL01"
  address   String?
  city      String?
  phone     String?
  email     String?
  // Local tax / service-charge config per outlet.
  taxRate         Decimal @default(0) @db.Decimal(5, 2) // percentage
  serviceCharge   Decimal @default(0) @db.Decimal(5, 2) // percentage
  currency        String  @default("LKR")
  isActive        Boolean @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // Relations
  userAssignments  UserOutletAssignment[]
  menuItems        MenuItem[]
  outletStock      OutletStock[]
  orders           Order[]
  purchases        Purchase[]
  expenses         Expense[]
  wasteLogs        WasteLog[]
  printers         Printer[]
  printJobs        PrintJob[]
  stockMovements   StockMovement[]
  transfersFrom    StockTransfer[]        @relation("TransferFromOutlet")
  transfersTo      StockTransfer[]        @relation("TransferToOutlet")

  @@index([isActive])
  @@map("outlets")
}

// ============================================================================
// AUTH & RBAC
// ============================================================================

model User {
  id           String   @id @default(cuid())
  email        String   @unique
  phone        String?  @unique
  passwordHash String
  fullName     String
  role         UserRole @default(CASHIER)
  isActive     Boolean  @default(true)
  lastLoginAt  DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  // A SUPER_ADMIN typically has assignments to all outlets; others to one+.
  outletAssignments UserOutletAssignment[]
  ordersCreated     Order[]                @relation("OrderCreatedBy")
  purchasesRecorded Purchase[]             @relation("PurchaseRecordedBy")
  expensesRecorded  Expense[]              @relation("ExpenseRecordedBy")
  wasteLogsRecorded WasteLog[]             @relation("WasteLogRecordedBy")
  stockMovements    StockMovement[]        @relation("StockMovementBy")
  refreshTokens     RefreshToken[]

  @@index([role])
  @@index([isActive])
  @@map("users")
}

// Join table: which users can act in which outlets, with an optional
// outlet-scoped role override (e.g. a CASHIER in one outlet, MANAGER in another).
model UserOutletAssignment {
  id       String    @id @default(cuid())
  userId   String
  outletId String
  // Optional per-outlet role override. Falls back to User.role when null.
  roleOverride UserRole?
  isActive     Boolean   @default(true)

  createdAt DateTime @default(now())

  user   User   @relation(fields: [userId], references: [id], onDelete: Cascade)
  outlet Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([userId, outletId])
  @@index([outletId])
  @@map("user_outlet_assignments")
}

// Rotating refresh tokens for JWT auth (Phase 2 will consume these).
model RefreshToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  revokedAt DateTime?
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
  @@map("refresh_tokens")
}

// ============================================================================
// MENU & RECIPE COSTING
// ============================================================================

model Category {
  id          String   @id @default(cuid())
  name        String   @unique // e.g. "Fried Rice", "Kottu", "Beverages"
  description String?
  sortOrder   Int      @default(0)
  isActive    Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  menuItems MenuItem[]

  @@map("categories")
}

// A sellable product. Multi-tenant: priced/available per outlet.
// e.g. "Chicken Fried Rice" with size variants handled via portion field.
model MenuItem {
  id          String   @id @default(cuid())
  outletId    String
  categoryId  String
  name        String // e.g. "Normal Chicken Fried Rice"
  description String?
  // Portion/size label, e.g. "Normal", "Large", "Family".
  portion     String?  @default("Normal")
  price       Decimal  @db.Decimal(10, 2) // selling price (outlet currency)
  imageUrl    String?
  isAvailable Boolean  @default(true)
  // Cached computed cost from the recipe (recalculated on recipe change).
  computedCost Decimal? @db.Decimal(10, 2)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet      Outlet       @relation(fields: [outletId], references: [id], onDelete: Cascade)
  category    Category     @relation(fields: [categoryId], references: [id])
  recipeItems RecipeItem[]
  orderItems  OrderItem[]

  // Same dish name can exist in multiple outlets, but unique within an outlet+portion.
  @@unique([outletId, name, portion])
  @@index([outletId])
  @@index([categoryId])
  @@map("menu_items")
}

// Master ingredient catalogue (global), stock is tracked per-outlet separately.
model Ingredient {
  id        String        @id @default(cuid())
  name      String        @unique // e.g. "Basmati Rice", "Chicken Breast", "Egg"
  baseUnit  UnitOfMeasure // canonical unit used for all stock math
  // Reference/average cost per base unit; real cost comes from purchases.
  averageCost Decimal     @default(0) @db.Decimal(12, 4)
  isActive    Boolean     @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  recipeItems    RecipeItem[]
  outletStock    OutletStock[]
  purchaseItems  PurchaseItem[]
  wasteLogItems  WasteLogItem[]
  stockMovements StockMovement[]
  transferItems  StockTransferItem[]

  @@map("ingredients")
}

// FRACTIONAL RECIPE COSTING.
// Links a MenuItem to the ingredients it consumes, with fractional quantities.
// e.g. 1 Normal Chicken Fried Rice = 200 GRAM rice + 100 GRAM chicken + 1 PIECE egg.
model RecipeItem {
  id           String        @id @default(cuid())
  menuItemId   String
  ingredientId String
  // Quantity of the ingredient consumed per 1 unit of the menu item,
  // expressed in `unit` (validated against Ingredient.baseUnit at app layer).
  quantity     Decimal       @db.Decimal(12, 4)
  unit         UnitOfMeasure

  menuItem   MenuItem   @relation(fields: [menuItemId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@unique([menuItemId, ingredientId])
  @@index([ingredientId])
  @@map("recipe_items")
}

// ============================================================================
// PER-OUTLET LIVE STOCK
// ============================================================================

// The composite (ingredientId, outletId) is the heart of per-outlet inventory.
// `quantityOnHand` is the live balance; StockMovement rows are the audit trail.
model OutletStock {
  id           String        @id @default(cuid())
  ingredientId String
  outletId     String
  quantityOnHand Decimal     @default(0) @db.Decimal(14, 4)
  // Reorder threshold for low-stock alerts.
  reorderLevel   Decimal     @default(0) @db.Decimal(14, 4)
  unit           UnitOfMeasure

  updatedAt DateTime @updatedAt

  ingredient Ingredient @relation(fields: [ingredientId], references: [id], onDelete: Cascade)
  outlet     Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)

  @@unique([ingredientId, outletId])
  @@index([outletId])
  @@map("outlet_stock")
}

// Immutable ledger of every change to stock, for full auditability.
model StockMovement {
  id           String            @id @default(cuid())
  outletId     String
  ingredientId String
  type         StockMovementType
  // Signed change in base units: positive = stock in, negative = stock out.
  quantity     Decimal           @db.Decimal(14, 4)
  unit         UnitOfMeasure
  // Snapshot of unit cost at time of movement (for COGS/valuation).
  unitCost     Decimal?          @db.Decimal(12, 4)
  // Resulting balance after this movement (denormalised for fast reporting).
  balanceAfter Decimal           @db.Decimal(14, 4)
  // Polymorphic source references (only one set, depending on `type`).
  orderId       String?
  purchaseId    String?
  wasteLogId    String?
  transferId    String?
  note          String?
  createdById   String?

  createdAt DateTime @default(now())

  outlet     Outlet      @relation(fields: [outletId], references: [id], onDelete: Cascade)
  ingredient Ingredient  @relation(fields: [ingredientId], references: [id])
  order      Order?      @relation(fields: [orderId], references: [id])
  purchase   Purchase?   @relation(fields: [purchaseId], references: [id])
  wasteLog   WasteLog?   @relation(fields: [wasteLogId], references: [id])
  createdBy  User?       @relation("StockMovementBy", fields: [createdById], references: [id])

  @@index([outletId, ingredientId])
  @@index([type])
  @@index([createdAt])
  @@map("stock_movements")
}

// ============================================================================
// ORDERS (POS) — state machine pipeline
// ============================================================================

model Customer {
  id        String   @id @default(cuid())
  name      String?
  phone     String?  @unique
  email     String?
  address   String?
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  orders Order[]

  @@map("customers")
}

model Order {
  id          String      @id @default(cuid())
  outletId    String
  // Human-friendly per-outlet sequential number, e.g. "COL01-000123".
  orderNumber String
  status      OrderStatus @default(DRAFT)
  type        OrderType   @default(TAKEAWAY)

  customerId  String?
  createdById String

  // Monetary breakdown (all in outlet currency).
  subtotal       Decimal @default(0) @db.Decimal(12, 2)
  discountAmount Decimal @default(0) @db.Decimal(12, 2)
  taxAmount      Decimal @default(0) @db.Decimal(12, 2)
  serviceCharge  Decimal @default(0) @db.Decimal(12, 2)
  totalAmount    Decimal @default(0) @db.Decimal(12, 2)

  notes String?

  // Pipeline timestamps (set as the order transitions through states).
  confirmedAt DateTime?
  inKitchenAt DateTime?
  readyAt     DateTime?
  completedAt DateTime?
  cancelledAt DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  customer       Customer?       @relation(fields: [customerId], references: [id])
  createdBy      User            @relation("OrderCreatedBy", fields: [createdById], references: [id])
  items          OrderItem[]
  payments       Payment[]
  stockMovements StockMovement[]
  printJobs      PrintJob[]

  @@unique([outletId, orderNumber])
  @@index([outletId, status])
  @@index([createdAt])
  @@map("orders")
}

model OrderItem {
  id         String  @id @default(cuid())
  orderId    String
  menuItemId String
  // Snapshot of name/price at time of sale (menu can change later).
  nameSnapshot  String
  unitPrice     Decimal @db.Decimal(10, 2)
  quantity      Int     @default(1)
  lineTotal     Decimal @db.Decimal(12, 2)
  notes         String? // e.g. "extra spicy", "no egg"

  order    Order    @relation(fields: [orderId], references: [id], onDelete: Cascade)
  menuItem MenuItem @relation(fields: [menuItemId], references: [id])

  @@index([orderId])
  @@map("order_items")
}

model Payment {
  id        String        @id @default(cuid())
  orderId   String
  method    PaymentMethod
  status    PaymentStatus @default(PENDING)
  amount    Decimal       @db.Decimal(12, 2)
  reference String? // gateway/transaction reference
  createdAt DateTime      @default(now())

  order Order @relation(fields: [orderId], references: [id], onDelete: Cascade)

  @@index([orderId])
  @@map("payments")
}

// ============================================================================
// PROCUREMENT — purchases increment inventory (the "credit" side of the ledger)
// ============================================================================

model Supplier {
  id        String   @id @default(cuid())
  name      String
  phone     String?
  email     String?
  address   String?
  isActive  Boolean  @default(true)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  purchases Purchase[]

  @@map("suppliers")
}

model Purchase {
  id            String   @id @default(cuid())
  outletId      String
  supplierId    String?
  invoiceNumber String?
  // Total cost of the purchase (sum of items + adjustments).
  totalAmount   Decimal  @db.Decimal(12, 2)
  notes         String?
  recordedById  String
  purchasedAt   DateTime @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  supplier       Supplier?       @relation(fields: [supplierId], references: [id])
  recordedBy     User            @relation("PurchaseRecordedBy", fields: [recordedById], references: [id])
  items          PurchaseItem[]
  stockMovements StockMovement[]

  @@index([outletId])
  @@index([purchasedAt])
  @@map("purchases")
}

// Each purchase line increments OutletStock and emits a PURCHASE StockMovement.
model PurchaseItem {
  id           String        @id @default(cuid())
  purchaseId   String
  ingredientId String
  quantity     Decimal       @db.Decimal(14, 4) // in `unit`
  unit         UnitOfMeasure
  unitCost     Decimal       @db.Decimal(12, 4) // cost per `unit`
  lineTotal    Decimal       @db.Decimal(12, 2)

  purchase   Purchase   @relation(fields: [purchaseId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([purchaseId])
  @@index([ingredientId])
  @@map("purchase_items")
}

// ============================================================================
// EXPENSES — non-inventory outgoings (the operational ledger)
// ============================================================================

model Expense {
  id           String          @id @default(cuid())
  outletId     String
  category     ExpenseCategory
  description  String
  amount       Decimal         @db.Decimal(12, 2)
  recordedById String
  incurredAt   DateTime        @default(now())

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet     Outlet @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recordedBy User   @relation("ExpenseRecordedBy", fields: [recordedById], references: [id])

  @@index([outletId, category])
  @@index([incurredAt])
  @@map("expenses")
}

// ============================================================================
// CHEF DAILY WASTE LOG — deducts inventory (the "loss" side of the ledger)
// ============================================================================

model WasteLog {
  id           String   @id @default(cuid())
  outletId     String
  recordedById String
  reason       String? // spoilage, spillage, over-prep, etc.
  loggedAt     DateTime @default(now())

  createdAt DateTime @default(now())

  outlet         Outlet          @relation(fields: [outletId], references: [id], onDelete: Cascade)
  recordedBy     User            @relation("WasteLogRecordedBy", fields: [recordedById], references: [id])
  items          WasteLogItem[]
  stockMovements StockMovement[]

  @@index([outletId])
  @@index([loggedAt])
  @@map("waste_logs")
}

// Each waste line deducts OutletStock and emits a WASTE StockMovement.
model WasteLogItem {
  id           String        @id @default(cuid())
  wasteLogId   String
  ingredientId String
  quantity     Decimal       @db.Decimal(14, 4)
  unit         UnitOfMeasure
  notes        String?

  wasteLog   WasteLog   @relation(fields: [wasteLogId], references: [id], onDelete: Cascade)
  ingredient Ingredient @relation(fields: [ingredientId], references: [id])

  @@index([wasteLogId])
  @@index([ingredientId])
  @@map("waste_log_items")
}

// ============================================================================
// INTER-OUTLET STOCK TRANSFERS (optional but supports multi-outlet ops)
// ============================================================================

model StockTransfer {
  id           String   @id @default(cuid())
  fromOutletId String
  toOutletId   String
  notes        String?
  transferredAt DateTime @default(now())
  createdAt    DateTime @default(now())

  fromOutlet Outlet              @relation("TransferFromOutlet", fields: [fromOutletId], references: [id])
  toOutlet   Outlet              @relation("TransferToOutlet", fields: [toOutletId], references: [id])
  items      StockTransferItem[]

  @@index([fromOutletId])
  @@index([toOutletId])
  @@map("stock_transfers")
}

model StockTransferItem {
  id           String        @id @default(cuid())
  transferId   String
  ingredientId String
  quantity     Decimal       @db.Decimal(14, 4)
  unit         UnitOfMeasure

  transfer   StockTransfer @relation(fields: [transferId], references: [id], onDelete: Cascade)
  ingredient Ingredient    @relation(fields: [ingredientId], references: [id])

  @@index([transferId])
  @@index([ingredientId])
  @@map("stock_transfer_items")
}

// ============================================================================
// HARDWARE — printers & print jobs (consumed by the Phase 5 KOT daemon)
// ============================================================================

model Printer {
  id        String   @id @default(cuid())
  outletId  String
  name      String // e.g. "Kitchen #1", "Cashier Counter"
  // Connection: kitchen printers are network (TCP/IP), receipt printers USB.
  type      PrintJobType // primary purpose (KOT vs RECEIPT)
  interface String // "tcp://192.168.1.50:9100" or "usb" identifier
  isActive  Boolean  @default(true)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet    Outlet     @relation(fields: [outletId], references: [id], onDelete: Cascade)
  printJobs PrintJob[]

  @@index([outletId])
  @@map("printers")
}

// Print jobs are emitted by the API and picked up by the standalone daemon
// over WebSocket. The daemon updates status as it processes each job.
model PrintJob {
  id        String         @id @default(cuid())
  outletId  String
  printerId String?
  orderId   String?
  type      PrintJobType
  status    PrintJobStatus @default(QUEUED)
  // Rendered ESC/POS payload or structured JSON for the daemon to format.
  payload   Json
  attempts  Int            @default(0)
  errorText String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  outlet  Outlet   @relation(fields: [outletId], references: [id], onDelete: Cascade)
  printer Printer? @relation(fields: [printerId], references: [id])
  order   Order?   @relation(fields: [orderId], references: [id])

  @@index([outletId, status])
  @@index([status])
  @@map("print_jobs")
}
