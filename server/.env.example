# PepperNet API — environment configuration

# PostgreSQL connection string (shared with the Prisma schema)
DATABASE_URL="postgresql://user:password@localhost:5432/peppernet?schema=public"

# JWT secrets — use long random strings, e.g. `openssl rand -base64 48`
JWT_ACCESS_SECRET="change-me-access-secret"
JWT_REFRESH_SECRET="change-me-refresh-secret"

# Token lifetimes
JWT_ACCESS_TTL="15m"
JWT_REFRESH_TTL_DAYS="30"

# Server
PORT="4000"
NODE_ENV="development"

# Comma-separated list of allowed origins for CORS (the Next.js POS frontend)
CORS_ORIGINS="http://localhost:3000"

# Cookie domain/security
COOKIE_SECURE="false"
